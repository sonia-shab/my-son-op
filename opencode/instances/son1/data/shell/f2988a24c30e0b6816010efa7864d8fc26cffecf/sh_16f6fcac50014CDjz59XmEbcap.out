=== e2e gate comment ===
  e2e:
    name: E2E Tests (Playwright)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    # Non-blocking ramp (issue #867): the suite has never run in CI, so the
    # first executions will surface real latent failures (the inert
    # waitForLivewire() wait, the self-skipping unit-map-boundary spec).
    # Ship continue-on-error:true now; promote to required only after two
    # consecutive green runs AND the two collateral fixes land (separate PRs,
    # preconditions for required status — see #867's git review).
    continue-on-error: true

    services:
      postgres:
        image: postgis/postgis:16-3.4
=== php86 comment ===
      - name: Run PHPStan
        run: vendor/bin/phpstan analyse --no-progress

  test-php86:
    name: PHP 8.6 Preview (non-blocking)
    runs-on: ubuntu-latest
    timeout-minutes: 10
    # Informational only: PHP 8.6 is pre-release (RC3 2026-10-08, GA 2026-11-19).
    # Same precedent as the mutation job — never blocks a merge; it surfaces
    # 8.6 incompatibilities and deprecations while there is still time to fix them.
    continue-on-error: true

    services:
      postgres:
        image: postgis/postgis:16-3.4
        env:
          POSTGRES_PASSWORD: secret
          POSTGRES_DB: h_dashboard_test
        options: >
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

=== mutation gate ===
  mutation:
    name: Mutation Testing
    # Manual-only (#1012): the job is green, but each run is expensive
    # (checkout, composer install and migrations before the single
    # `pest --mutate` line below) and it used to spend ~23 minutes
    # on every PR for a signal that gates nothing (`continue-on-error: true`).
    # Re-enable on PRs by dropping this `if:`. The manual "Run workflow"
    # button appears only once this trigger is on the default branch.
    if: github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    # Non-blocking: the score is informational, so keeping this job off PRs
    # removes no quality gate.
    continue-on-error: true

    services:
      postgres:
